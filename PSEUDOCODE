START
// Initialize ANSI colors and word list (APPLE, BRAVE, CRANE, etc.)
SET WORD_BANK = [list of 5-letter words]

FUNCTION pick_random_word(words)
    RETURN random word from words
END FUNCTION

FUNCTION get_valid_guess(word_length)
    WHILE TRUE
        PROMPT and GET guess, convert to uppercase
        IF guess is valid length and alphabetic THEN RETURN guess
    END WHILE
END FUNCTION

FUNCTION evaluate_guess(secret, guess)
    // Pass 1: Mark exact matches as GREEN
    // Pass 2: Mark misplaced letters as YELLOW, and unmatched as GRAY
    RETURN formatted color string array
END FUNCTION

FUNCTION play_game()
    SET secret_word = pick_random_word(WORD_BANK)
    SET max_attempts = 6, attempt = 0
    WHILE attempt < max_attempts
        GET valid guess, increment attempt, evaluate guess, and display board
        IF guess equals secret_word THEN DISPLAY win message and EXIT
    END WHILE
    DISPLAY loss message with secret_word
END FUNCTION

CALL play_game()
END
