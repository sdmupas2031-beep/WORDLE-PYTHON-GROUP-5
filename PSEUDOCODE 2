 DATA STRUCTURES
DEFINE STEM_WORD_BANK AS Dictionary OF Categories:
    "Computer Science": {
        "ARRAY": { pos, def, example },
        "CACHE": { pos, def, example },
        ...
    },
    "Biology & Medicine": {
        "AXONS": { pos, def, example },
        "BIOME": { pos, def, example },
        ...
    },
    "Physics & Chemistry": {
        "ANODE": { pos, def, example },
        "ALLOY": { pos, def, example },
        ...
    }
HELPER FUNCTIONS

FUNCTION ChooseCategory()
    DISPLAY "=== STEM WORDLE: SELECT A CATEGORY ==="
    categories ← LIST of keys from STEM_WORD_BANK

    FOR i FROM 1 TO LENGTH(categories) DO
        DISPLAY i + ". " + categories[i]
    END FOR
    DISPLAY (LENGTH(categories) + 1) + ". All STEM Categories (Mixed)"

    LOOP FOREVER
        INPUT choice
        IF choice IS a valid number between 1 AND LENGTH(categories) THEN
            selectedName ← categories[choice]
            RETURN (selectedName, STEM_WORD_BANK[selectedName])
        ELSE IF choice EQUALS LENGTH(categories) + 1 THEN
            combinedDict ← EMPTY Dictionary
            FOR EACH categoryDict IN STEM_WORD_BANK VALUES DO
                MERGE categoryDict INTO combinedDict
            END FOR
            RETURN ("All STEM Categories", combinedDict)
        ELSE
            DISPLAY "Invalid choice. Please try again."
        END IF
    END LOOP
END FUNCTION

FUNCTION GetValidGuess(wordLength, wordInfo, hintUsed)
    LOOP FOREVER
        IF hintUsed IS FALSE THEN
            DISPLAY "Enter a " + wordLength + "-letter word (or type 'HINT' for definition): "
        ELSE
            DISPLAY "Enter a " + wordLength + "-letter word: "
        END IF

        INPUT guess
        CONVERT guess TO UPPERCASE and TRIM whitespace

        IF guess EQUALS "HINT" THEN
            DISPLAY "[HINT] (" + wordInfo.pos + ") " + wordInfo.def
            hintUsed ← TRUE
            CONTINUE LOOP
        END IF

        IF LENGTH(guess) EQUALS wordLength AND guess CONTAINS ONLY LETTERS THEN
            RETURN (guess, hintUsed)
        ELSE
            DISPLAY "Invalid input. Please enter exactly " + wordLength + " letters."
        END IF
    END LOOP
END FUNCTION

FUNCTION EvaluateGuess(secret, guess)
    result ← ARRAY of size LENGTH(secret) filled with empty strings
    secretChars ← ARRAY of characters from secret

    // First pass: Check for exact position matches (Green)
    FOR i FROM 0 TO LENGTH(guess) - 1 DO
        IF guess[i] EQUALS secretChars[i] THEN
            result[i] ← FORMAT_GREEN(guess[i])
            secretChars[i] ← NULL   // Mark character as matched
        END IF
    END FOR

    // Second pass: Check for misplaced letters (Yellow) or non-matches (Gray)
    FOR i FROM 0 TO LENGTH(guess) - 1 DO
        IF result[i] IS EMPTY THEN
            IF guess[i] EXISTS IN secretChars THEN
                result[i] ← FORMAT_YELLOW(guess[i])
                index ← FIRST_INDEX_OF(guess[i], secretChars)
                secretChars[index] ← NULL
            ELSE
                result[i] ← FORMAT_GRAY(guess[i])
            END IF
        END IF
    END FOR
