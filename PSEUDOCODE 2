START PROGRAM

#INITIALIZATION & HELPERS
DEFINE ANSI colors and STEM_WORD_BANK (categories with 5-letter words, parts of speech, definitions, and examples).

FUNCTION choose_category():
    DISPLAY category menu (Computer Science, Biology & Medicine, Physics & Chemistry, or Mixed).
    LOOP until valid choice is made and return the selected category dictionary.
END FUNCTION

FUNCTION pick_random_word(category_dict):
    RETURN a random word and its metadata from the selected category.
END FUNCTION

FUNCTION get_valid_guess(word_length, word_info, hint_used):
    LOOP to get user input.
    IF user enters "HINT", display part of speech and definition, then continue.
    RETURN uppercase guess once it matches the required length and character type.
END FUNCTION

FUNCTION evaluate_guess(secret, guess):
    COMPARE guess against secret word.
    FIRST PASS: Mark exact letter matches as GREEN.
    SECOND PASS: Mark misplaced letters as YELLOW and unused letters as GRAY.
    RETURN colored feedback string.
END FUNCTION

FUNCTION display_vocab_card(word, info):
    DISPLAY formatted card with word, part of speech, definition, and example.
END FUNCTION

# GAME LOGIC & REVIEW
FUNCTION play_round(missed_words):
    SELECT category and random word.
    LOOP up to 6 attempts: get guess, evaluate feedback, update board display.
    IF guess matches secret, display vocab card and exit round.
    IF attempts run out, display vocab card and save word to missed_words.
END FUNCTION

FUNCTION review_missed_words(missed_words):
    IF missed_words is not empty, quiz the user on definitions/terms and track score.
END FUNCTION

// 3. MAIN EXECUTION
FUNCTION main():
    CREATE missed_words dictionary.
    LOOP: play a round of STEM Wordle, then ask if user wants to play again.
    IF there are missed words, offer a review quiz.
    DISPLAY exit message.
END FUNCTION

CALL main()
END PROGRAM


